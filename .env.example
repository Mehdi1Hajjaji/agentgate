# Keep these values outside Git. Agents receive CHANGEWARDEN_AGENT_TOKEN only.
CHANGEWARDEN_AGENT_TOKEN=replace-with-a-long-random-agent-token
CHANGEWARDEN_ADMIN_TOKEN=replace-with-a-separate-long-random-reviewer-token
CHANGEWARDEN_GITHUB_APP_ID=
CHANGEWARDEN_GITHUB_INSTALLATION_ID=
CHANGEWARDEN_GITHUB_PRIVATE_KEY_PATH=/run/secrets/github_app_private_key.pem
CHANGEWARDEN_GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
CHANGEWARDEN_DATA_DIR=./data
