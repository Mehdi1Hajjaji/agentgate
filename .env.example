# Keep these values outside Git.  Agents receive AGENTGATE_AGENT_TOKEN only.
AGENTGATE_AGENT_TOKEN=replace-with-a-long-random-agent-token
AGENTGATE_ADMIN_TOKEN=replace-with-a-separate-long-random-reviewer-token
AGENTGATE_GITHUB_APP_ID=
AGENTGATE_GITHUB_INSTALLATION_ID=
AGENTGATE_GITHUB_PRIVATE_KEY_PATH=/run/secrets/github_app_private_key.pem
AGENTGATE_GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
AGENTGATE_DATA_DIR=./data
